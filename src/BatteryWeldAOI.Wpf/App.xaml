<Application x:Class="BatteryWeldAOI.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="WindowBack" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="PanelBack" Color="#FF252526"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#FF3F3F46"/>
        <SolidColorBrush x:Key="TextMain" Color="#FFD4D4D4"/>
        <SolidColorBrush x:Key="TextDim" Color="#FF9E9E9E"/>
        <SolidColorBrush x:Key="Accent" Color="#FF007ACC"/>
        <SolidColorBrush x:Key="OkBrush" Color="#FF2E7D32"/>
        <SolidColorBrush x:Key="NgBrush" Color="#FFC62828"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#FFEF6C00"/>
        <SolidColorBrush x:Key="PendingBrush" Color="#FF3C3C3C"/>
        <SolidColorBrush x:Key="InspectingBrush" Color="#FF1565C0"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF333337"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF333337"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>
    </Application.Resources>
</Application>
