<Window x:Class="BatteryWeldAOI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BatteryWeldAOI — 电池包焊后视觉检测系统"
        Width="1360" Height="890" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBack}"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <DockPanel>

        <!-- ======== 顶部工具栏 ======== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBack}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="▶ 开始检测" Command="{Binding StartCommand}" FontWeight="Bold"/>
                    <Button Content="■ 停止" Command="{Binding StopCommand}"/>
                    <Button Content="⟲ 复位" Command="{Binding ResetCommand}"/>
                    <Button Content="导出报表" Command="{Binding ExportCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="设备状态: " Foreground="{StaticResource TextDim}"/>
                    <TextBlock Text="{Binding MachineStateText}" FontWeight="Bold" Foreground="#FF4FC1FF"/>
                    <TextBlock Text="   用时: " Foreground="{StaticResource TextDim}"/>
                    <TextBlock Text="{Binding ElapsedText}" FontFamily="Consolas"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 进度条 -->
        <Border DockPanel.Dock="Top" Background="#FF111111" Padding="10,3,10,5">
            <StackPanel>
                <ProgressBar Height="8" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                             Background="#FF2A2A2A" Foreground="#FF007ACC"
                             BorderBrush="{StaticResource PanelBorder}"/>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="节拍:" Foreground="{StaticResource TextDim}"/>
                    <TextBlock Text="{Binding CycleTimeText}" Margin="6,0,0,0"/>
                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextDim}">
                        <Run Text="{Binding ProcessedCount, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ======== 底部日志 ======== -->
        <Border DockPanel.Dock="Bottom" Background="#FF1B1B1B" Height="170"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0">
            <DockPanel Margin="6,4,6,6">
                <TextBlock DockPanel.Dock="Top" Text="运行日志" Foreground="{StaticResource TextDim}"
                           Margin="4,0,0,3"/>
                <ListBox x:Name="LogList" ItemsSource="{Binding Logs}"
                         Background="Transparent" Foreground="#FFD4D4D4"
                         BorderThickness="0" FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>

        <!-- ======== 主区域 ======== -->
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <!-- 左：实时图像 -->
            <Border Grid.Column="0" Background="#FF0D0D0D"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="4">
                <Grid>
                    <Image Source="{Binding CurrentImage}" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock Text="{Binding ImageCaption}" Margin="10,8,0,0"
                               FontSize="14" FontWeight="Bold" Foreground="#FF4FC1FF">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImageCaption}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="等待开始检测…" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}" FontSize="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- 右：输入源 / 统计 / 点位矩阵 / 参数 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- 输入源 -->
                    <GroupBox Header="输入源">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <RadioButton Content="仿真演示" IsChecked="{Binding IsSimulationSource}"
                                             Margin="0,0,10,0" Foreground="{StaticResource TextMain}"/>
                                <RadioButton Content="视频文件" IsChecked="{Binding IsVideoFileSource}"
                                             Margin="0,0,10,0" Foreground="{StaticResource TextMain}"/>
                                <RadioButton Content="图片文件夹" IsChecked="{Binding IsImageFolderSource}"
                                             Margin="0,0,10,0" Foreground="{StaticResource TextMain}"/>
                                <RadioButton Content="摄像头" IsChecked="{Binding IsCameraSource}"
                                             Foreground="{StaticResource TextMain}"/>
                            </StackPanel>

                            <!-- 视频文件设置 -->
                            <StackPanel Visibility="{Binding IsVideoFileSource, Converter={StaticResource BoolToVis}}">
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="浏览..." Command="{Binding BrowseVideoCommand}"
                                            Margin="6,0,0,0" MinWidth="64" Padding="8,4"/>
                                    <TextBox Text="{Binding VideoFilePath, Mode=OneWay}" IsReadOnly="True"
                                             ToolTip="{Binding VideoFilePath}"/>
                                </DockPanel>
                                <TextBlock Text="逐帧检测：每一帧作为一个焊点（分辨率自动缩放至配置值）"
                                           Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- 图片文件夹设置 -->
                            <StackPanel Visibility="{Binding IsImageFolderSource, Converter={StaticResource BoolToVis}}">
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="浏览..." Command="{Binding BrowseImageFolderCommand}"
                                            Margin="6,0,0,0" MinWidth="64" Padding="8,4"/>
                                    <TextBox Text="{Binding ImageFolderPath, Mode=OneWay}" IsReadOnly="True"
                                             ToolTip="{Binding ImageFolderPath}"/>
                                </DockPanel>
                                <TextBlock Text="批量识别：文件夹内图片按文件名自然顺序逐张作为一个焊点（支持 png/jpg/bmp/tiff，分辨率自动缩放至配置值）"
                                           Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- 摄像头设置 -->
                            <StackPanel Visibility="{Binding IsCameraSource, Converter={StaticResource BoolToVis}}">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="设备索引" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding Config.CameraDeviceIndex}" Width="48"
                                             HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <Button Content="{Binding TogglePreviewText}" Command="{Binding TogglePreviewCommand}"
                                            HorizontalAlignment="Right" MinWidth="88" Padding="8,4"/>
                                </DockPanel>
                                <TextBlock Text="DirectShow 设备，从 0 开始编号；「打开预览」实时查看画面，检测时逐帧判定"
                                           Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- 仿真无附加设置 -->
                            <TextBlock Visibility="{Binding IsSimulationSource, Converter={StaticResource BoolToVis}}"
                                       Text="合成图像剧本（缺陷点位固定），同种子结果可复现"
                                       Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 检测统计 -->
                    <GroupBox Header="检测统计">
                        <UniformGrid Columns="3">
                            <Border Background="{StaticResource PanelBack}" Margin="2" Padding="6" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalCount, Mode=OneWay}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="总点位" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBack}" Margin="2" Padding="6" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock Text="{Binding ProcessedCount, Mode=OneWay}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FF4FC1FF"/>
                                    <TextBlock Text="已检" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBack}" Margin="2" Padding="6" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock Text="{Binding OkCount, Mode=OneWay}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FF66BB6A"/>
                                    <TextBlock Text="OK" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBack}" Margin="2" Padding="6" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock Text="{Binding NgCount, Mode=OneWay}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FFEF5350"/>
                                    <TextBlock Text="NG" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBack}" Margin="2" Padding="6" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock Text="{Binding ErrorCount, Mode=OneWay}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FFFFA726"/>
                                    <TextBlock Text="异常" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBack}" Margin="2" Padding="6" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock Text="{Binding CycleTimeText, Mode=OneWay}" FontSize="15" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Text="节拍" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </GroupBox>

                    <!-- 点位矩阵（点击已完成格子查看详情） -->
                    <GroupBox Header="点位矩阵">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Points}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- MinWidth=0 覆盖全局按钮样式的 MinWidth=88，
                                             否则 8 列格子宽 704px 会撑爆面板 -->
                                        <Button Click="OnPointCellClick"
                                                ToolTip="{Binding Tooltip}" Cursor="Hand"
                                                MinWidth="0" MinHeight="0"
                                                Margin="1" Padding="0" Focusable="False">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Cell" Background="{Binding Brush}"
                                                            CornerRadius="2" Height="34">
                                                        <TextBlock Text="{Binding IndexText}" FontSize="13"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Cell" Property="Opacity" Value="0.75"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="Cell" Property="Opacity" Value="0.45"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="绿=OK   红=NG   橙=异常   蓝=检测中&#10;点击已完成的格子查看检测详情"
                                       Foreground="{StaticResource TextDim}" FontSize="11" Margin="2,6,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 参数设置 -->
                    <GroupBox Header="参数设置（配方）">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="点位数" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding Config.PointCount, UpdateSourceTrigger=LostFocus}"
                                     IsEnabled="{Binding CanEditParams}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="随机种子" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding Config.RandomSeed}"
                                     IsEnabled="{Binding CanEditParams}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="流水线线程" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding Config.WorkerCount}"
                                     IsEnabled="{Binding CanEditParams}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="焊偏公差 mm" VerticalAlignment="Center" Margin="0,0,8,4"
                                       ToolTip="合成偏移（焊环圆心 ↔ 孔心）超过本值即判焊偏 NG。可直接改，运行中锁定，存配置后持久化。"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding Config.Inspection.OffsetToleranceMm, StringFormat=F2}"
                                     IsEnabled="{Binding CanEditParams}"
                                     ToolTip="默认 6.6mm 由现场 480 帧厂商良品实测推出（最大值 5.76mm × 1.15），只保证良品不被误判，不是工艺规格。工艺给出正式值后请改这里。"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="轴运动耗时 ms" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding Config.Inspection.PlcMoveTimeMs}"
                                     IsEnabled="{Binding CanEditParams}"/>

                            <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4"
                                      Content="保存逐点标注图 PNG"
                                      IsChecked="{Binding Config.SaveAnnotatedImages}"
                                      IsEnabled="{Binding CanEditParams}"/>

                            <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Content="保存配置"
                                    Command="{Binding SaveConfigCommand}" Margin="0,4,0,0"/>
                        </Grid>
                    </GroupBox>

                    <!-- 高级视觉参数：全部是「尺度相对量」，不是绝对像素。
                         分母：×短边 = 图像短边 base；×焊环 = 焊环半径。
                         换镜头/改分辨率不需要重新标定这些值——这正是本算法与旧版
                         （绝对像素阈值，只在合成图上成立）的根本区别。 -->
                    <GroupBox Header="高级视觉参数（尺度相对量，一般无需修改）">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="纹理窗口 ×短边" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding Config.Inspection.TextureWindowRatio, StringFormat=F3}"
                                     ToolTip="局部标准差窗口边长。需大于单个鱼鳞斑、小于焊环直径。"
                                     IsEnabled="{Binding CanEditParams}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="纹理阈值系数 k" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding Config.Inspection.TextureThresholdK, StringFormat=F2}"
                                     ToolTip="阈值 = 中位数 + k×(p99 − 中位数)。调大更严格（漏检风险↑），调小更宽松（误检风险↑）。"
                                     IsEnabled="{Binding CanEditParams}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="焊环半径下限 ×短边" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding Config.Inspection.MinRingRadiusRatio, StringFormat=F3}"
                                     ToolTip="低于此值判为漏焊。真机良品实测 0.155~0.198。"
                                     IsEnabled="{Binding CanEditParams}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="焊环半径上限 ×短边" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding Config.Inspection.MaxRingRadiusRatio, StringFormat=F3}"
                                     ToolTip="超过此值视为测量失败（锁定了错误目标），交人工复核。"
                                     IsEnabled="{Binding CanEditParams}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="炸焊半径 ×短边" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding Config.Inspection.BlowoutRingRadiusRatio, StringFormat=F3}"
                                     ToolTip="超过此值判炸焊。⚠ 本项目无真实炸焊样本，该值由良品分布外推，需用现场 NG 样本重新标定。"
                                     IsEnabled="{Binding CanEditParams}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="孔洞半径下限 ×焊环" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding Config.Inspection.MinPinRadiusRatio, StringFormat=F2}"
                                     ToolTip="真机良品实测 0.255±0.036。"
                                     IsEnabled="{Binding CanEditParams}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="孔洞半径上限 ×焊环" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding Config.Inspection.MaxPinRadiusRatio, StringFormat=F2}"
                                     ToolTip="超出范围报测量失败而非给出错误偏移量。"
                                     IsEnabled="{Binding CanEditParams}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="卡尺内边界 ×焊环" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding Config.Inspection.PinSearchInnerRatio, StringFormat=F3}"
                                     ToolTip="⚠ 不要调大。必须满足 内边界 &lt; 孔半径 − 偏移量，否则背向孔的射线整条落在熔核纹理上，会把焊偏测成合格。"
                                     IsEnabled="{Binding CanEditParams}"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="飞溅颗粒数上限" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="8" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding Config.Inspection.MaxSpatterCount}"
                                     ToolTip="环外粗糙颗粒数超过此值判飞溅。"
                                     IsEnabled="{Binding CanEditParams}"/>

                            <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" FontSize="11"
                                       Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                                       Text="上述比例均取自 28 个真机良品样本的实测分布，并在分布外留出物理余量，正常生产无需调整。修改后请先在良品样本上复测，确认不产生误判再投入。"/>
                        </Grid>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
